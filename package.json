{
  "name": "sheetforge",
  "private": true,
  "version": "0.7.12",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "test": "npm run typecheck:tests && npm run test:structure && npm run test:behavior",
    "preview": "vite preview",
    "tauri": "tauri",
    "test:structure": "node --test tests/*.test.mjs",
    "test:behavior": "vitest run",
    "typecheck:tests": "tsc --project tsconfig.test.json"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "element-plus": "^2.9.0",
    "pinia": "^2.3.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/node": "22.20.5",
    "@vitejs/plugin-vue": "^5.2.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "5.0.3",
    "vue-tsc": "^2.1.0"
  }
}
